# Required for AI features. Keep this only on the server, never in the app.
ANTHROPIC_API_KEY=
# Model used for all mascot calls.
CLAUDE_MODEL=claude-opus-5
# Optional: semantic search embeddings (https://www.voyageai.com). Without it the app uses on-device keyword search.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Optional shared key the app sends as x-app-key.
APP_KEY=
# Requests per install per hour.
HOURLY_LIMIT=60
PORT=8787
