# Local development (npm run dev -w server). In production these live in Cloudflare (see docs/DEPLOY.md).
ANTHROPIC_API_KEY=
# The mascot's voice: reactions, chat, letters, scenarios, memory notes.
CLAUDE_MODEL_VOICE=claude-sonnet-5
# Cheap extraction of people and places.
CLAUDE_MODEL_FAST=claude-haiku-4-5
# Optional: semantic search embeddings (https://www.voyageai.com). Without it the app uses on-device keyword search.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Optional shared key the app sends as x-app-key.
APP_KEY=
# Key for reading anonymous usage counters: GET /v1/stats with header x-admin-key.
ADMIN_KEY=
HOURLY_LIMIT=60
PORT=8787
